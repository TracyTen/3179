{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Travel Purpose Disparity Across Tourism Metrics (YE Jun 2026)",
  "width": 500,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/TracyTen/3179/refs/heads/main/data/TRA_purpose.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Share": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Financial_Period == 'Jun-2026'"
    }
  ],
  "encoding": {
    "x": {
      "field": "Measure",
      "type": "nominal",
      "sort": ["Domestic_Trips", "Visitor_Nights", "Regional_Expenditure"],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelFontWeight": "bold"
      }
    },
    "y": {
      "field": "Share",
      "type": "quantitative",
      "title": "Share of Total (%)",
      "scale": {"domain": [0, 65]}
    },
    "color": {
      "field": "Purpose",
      "type": "nominal",
      "title": "Travel Purpose",
      "scale": {
        "domain": [
          "Holiday",
          "Visiting Friends and Relatives",
          "Business",
          "Other"
        ],
        "range": ["#4477AA", "#EE7733", "#228833", "#CCBB44"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 8,
        "dy": -8,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "Share",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}