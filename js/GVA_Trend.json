{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Tourism Economic Contribution Heatmap (Indexed: 2016–17 = 100)",
  "width": 600,
  "height": 450,
  "data": {
    "url": "https://raw.githubusercontent.com/TracyTen/3179/refs/heads/main/data/GVA_Trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "GVA": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "first_value",
          "field": "GVA",
          "as": "baseline"
        }
      ],
      "groupby": ["Region"],
      "sort": [
        {
          "field": "Financial_Year",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.GVA / datum.baseline * 100",
      "as": "gva_index"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "Financial_Year",
      "type": "ordinal",
      "title": "Financial Year",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "Region",
      "type": "nominal",
      "title": "Tourism Region",
      "sort": {"field": "State", "order": "ascending"}
    },
    "color": {
      "field": "gva_index",
      "type": "quantitative",
      "title": "GVA Index",
      "scale": {
        "scheme": "plasma"
      }
    },
    "tooltip": [
      {"field": "Region", "type": "nominal", "title": "Region"},
      {"field": "State", "type": "nominal", "title": "State"},
      {"field": "Financial_Year", "type": "ordinal", "title": "Financial Year"},
      {"field": "GVA", "type": "quantitative", "title": "GVA ($m)", "format": ",.0f"},
      {"field": "gva_index", "type": "quantitative", "title": "GVA Index", "format": ".1f"}
    ]
  },
  "config": {
    "axis": {"grid": false}
  }
}
