{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Direct Tourism Economic Activity by Region (2023–24)",
  "width": 700,
  "height": 450,
  "projection": {
    "type": "equirectangular",
    "center": [134, -28],
    "scale": 700
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TracyTen/3179/refs/heads/main/js/Tourism%20Regions%202026.json",
    "format": {
      "type": "topojson",
      "feature": "Tourism Regions 2026"
    }
  },
  "transform": [
    {
      "lookup": "properties.TR_NAME",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/TracyTen/3179/refs/heads/main/data/tourism_regions.csv"
        },
        "key": "Region",
        "fields": ["Consumption", "GVA", "GRP", "Filled_Jobs"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "Consumption",
      "type": "quantitative",
      "title": "Consumption ($M AUD)",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {"field": "properties.TR_NAME", "type": "nominal", "title": "Tourism Region"},
      {"field": "Consumption", "type": "quantitative", "title": "Direct Consumption ($M)", "format": "$,.0f"},
      {"field": "GVA", "type": "quantitative", "title": "Direct GVA ($M)", "format": "$,.0f"},
      {"field": "GRP", "type": "quantitative", "title": "Direct GRP ($M)", "format": "$,.0f"},
      {"field": "Filled_Jobs", "type": "quantitative", "title": "Filled Jobs ('000)", "format": ".1f"}
    ]
  }
}