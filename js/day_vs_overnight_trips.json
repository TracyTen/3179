{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "State Tourism Yield Distribution: Day Trip vs. Overnight Nightly Spend ($ AUD)",
  "width": 580,
  "height": 260,
  "data": {
    "url": "https://raw.githubusercontent.com/TracyTen/3179/refs/heads/main/data/day_vs_overnight.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Day_Spend_Per_Trip": "number",
        "Overnight_Spend_Per_Night": "number"
      }
    }
  },
  "layer": [
    {
      "transform": [{"calculate": "'Day Trip Yield ($/Trip)'", "as": "Category"}],
      "layer": [
        {
          "mark": {
            "type": "boxplot",
            "extent": "min-max",
            "size": 38,
            "outliers": false,
            "box": {"fill": "#eef2f5", "stroke": "#7f8c8d", "strokeWidth": 1.5},
            "rule": {"color": "#7f8c8d", "strokeWidth": 1.5},
            "median": {"color": "#333333", "size": 2}
          },
          "encoding": {
            "y": {"field": "Category", "type": "nominal", "title": null},
            "x": {"field": "Day_Spend_Per_Trip", "type": "quantitative", "title": "Average Spend ($ AUD)", "scale": {"zero": false}}
          }
        },
        {
          "mark": {"type": "point", "filled": true, "size": 90, "opacity": 0.9, "stroke": "#2c3e50", "strokeWidth": 1},
          "encoding": {
            "y": {"field": "Category", "type": "nominal"},
            "x": {"field": "Day_Spend_Per_Trip", "type": "quantitative"},
            "color": {"field": "State", "type": "nominal", "title": "State / Territory", "scale": {"scheme": "category10"}},
            "tooltip": [
              {"field": "State", "type": "nominal"},
              {"field": "Day_Spend_Per_Trip", "type": "quantitative", "title": "Day Spend ($)", "format": "$,.2f"}
            ]
          }
        }
      ]
    },
    {
      "transform": [{"calculate": "'Overnight Yield ($/Night)'", "as": "Category"}],
      "layer": [
        {
          "mark": {
            "type": "boxplot",
            "extent": "min-max",
            "size": 38,
            "outliers": false,
            "box": {"fill": "#eef2f5", "stroke": "#7f8c8d", "strokeWidth": 1.5},
            "rule": {"color": "#7f8c8d", "strokeWidth": 1.5},
            "median": {"color": "#333333", "size": 2}
          },
          "encoding": {
            "y": {"field": "Category", "type": "nominal", "title": null},
            "x": {"field": "Overnight_Spend_Per_Night", "type": "quantitative", "scale": {"zero": false}}
          }
        },
        {
          "mark": {"type": "point", "filled": true, "size": 90, "opacity": 0.9, "stroke": "#2c3e50", "strokeWidth": 1},
          "encoding": {
            "y": {"field": "Category", "type": "nominal"},
            "x": {"field": "Overnight_Spend_Per_Night", "type": "quantitative"},
            "color": {"field": "State", "type": "nominal", "title": "State / Territory"},
            "tooltip": [
              {"field": "State", "type": "nominal"},
              {"field": "Overnight_Spend_Per_Night", "type": "quantitative", "title": "Overnight Nightly Spend ($)", "format": "$,.2f"}
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "axis": {"grid": true}
  }
}